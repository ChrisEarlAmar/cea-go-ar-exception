# This file is loaded automatically when you run the Go API from the project root.
# Copy it to .env, replace the placeholders, and do not commit the real credentials.
# Use one value per line. Do not add a trailing backslash.
ORACLE_SID=your_sid
ORACLE_HOST=your_oracle_host
ORACLE_PORT=1521
ORACLE_USERNAME=your_read_only_username
ORACLE_PASSWORD=your_password
PORT=8012
